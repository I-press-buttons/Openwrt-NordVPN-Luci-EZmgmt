#!/usr/bin/ucode -S
// SPDX-License-Identifier: MIT
// One-shot NordVPN server-list cache updater. Invoked by the nordvpn procd
// service and safe to run manually. Optional --job-id claims a reservation.

'use strict';

import { cursor } from 'uci';
const _common = require('nordvpn.common');
const load_settings = _common.load_settings,
      cache_file_path = _common.cache_file_path,
      log = _common.log;
const fetch_and_build = require('nordvpn.cache').fetch_and_build;

let uci = cursor();
let settings = load_settings(uci);
let path = cache_file_path(settings);

let job_index = index(ARGV, '--job-id');
let job_id = job_index >= 0 ? ARGV[job_index + 1] : null;
if (job_index >= 0 && !job_id) exit(1);
let res = fetch_and_build(path, job_id);
if (!res || res.error) {
	log('cache update failed: ' + (res ? res.error : 'unknown error'));
	exit(1);
}

printf('nordvpn-cache-update: cached %d servers in %d cities across %d countries -> %s\n',
	res.stats.gateways, res.stats.cities, res.stats.countries, path);
exit(0);
